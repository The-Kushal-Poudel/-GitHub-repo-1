APP_NAME="Kushal Portfolio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local development can use SQLite:
DB_CONNECTION=sqlite

# Production (Neon PostgreSQL):
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Exact Vercel URL. Add extra preview/custom domains as comma-separated values.
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=

# Cloudinary: CLOUDINARY_URL alone is enough. Separate values are also supported.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PREFIX=

# Used by `php artisan admin:create --no-interaction`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_INITIAL_DATA=false

# Contact messages are always saved to the database. Log mail is safe for free hosting.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_EXPIRATION=1440
